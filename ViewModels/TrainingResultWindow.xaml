<Window x:Class="StockKLineTrainer.TrainingResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="训练结果"
        Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        BorderThickness="0"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False">

    <!-- 关键：Margin="-2" 向四周扩展 2px，盖住 DWM 强制画的黑边 -->
    <Grid Margin="-2">
        <!-- 半透明遮罩（点击关闭） -->
        <Border Background="#80000000" MouseDown="Grid_MouseDown" />

        <!-- 白色内容卡片 -->
        <Border Background="White"
                CornerRadius="12"
                Width="380"
                Height="440"
                BorderThickness="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.35" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="训练结果"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0" />

                <Grid Grid.Row="1" Margin="30,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="训练标的:" FontSize="13" Foreground="#666" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StockName}" FontSize="13" FontWeight="Bold" Foreground="#FF8C00" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="训练时间:" FontSize="13" Foreground="#666" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DateRange}" FontSize="13" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="本局盈亏:" FontSize="13" Foreground="#666" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfitAmount, StringFormat={}{0:F2}}" FontSize="13" FontWeight="Bold" Foreground="{Binding ProfitBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="本局收益:" FontSize="13" Foreground="#666" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfitPct, StringFormat={}{0:F2}%}" FontSize="13" FontWeight="Bold" Foreground="{Binding ProfitBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="区间涨跌幅:" FontSize="13" Foreground="#666" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IntervalChangePct, StringFormat={}{0:F2}%}" FontSize="13" FontWeight="Bold" Foreground="{Binding IntervalBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="开仓次数:" FontSize="13" Foreground="#666" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding OpenCount}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="开仓胜率:" FontSize="13" Foreground="#666" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding WinRate, StringFormat={}{0:F2}%}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="本局用时:" FontSize="13" Foreground="#666" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ElapsedTime}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Button Content="复盘" Width="100" Height="38" Margin="5,0"
                            Background="White" Foreground="#E91E63" BorderBrush="#E91E63" BorderThickness="1"
                            FontSize="13" Cursor="Hand" Click="Review_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="19">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="结束" Width="100" Height="38" Margin="5,0"
                            Background="White" Foreground="#666" BorderBrush="#DDD" BorderThickness="1"
                            FontSize="13" Cursor="Hand" Click="End_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="19">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="下一局" Width="120" Height="38" Margin="5,0"
                            Background="#E91E63" Foreground="White" BorderThickness="0"
                            FontSize="13" FontWeight="Bold" Cursor="Hand" Click="NextGame_Click"
                            IsDefault="True">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="19">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>