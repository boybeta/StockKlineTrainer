    <Color x:Key="Semantic.Profit.Color">#FF3232</Color>
    <SolidColorBrush x:Key="Semantic.Profit" Color="{StaticResource Semantic.Profit.Color}"/>
    <Color x:Key="Semantic.Loss.Color">#00A800</Color>
    <SolidColorBrush x:Key="Semantic.Loss" Color="{StaticResource Semantic.Loss.Color}"/>
