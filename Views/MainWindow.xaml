<Window x:Class="BaozhuKLineTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="爆竹K线训练助手" Width="1500" Height="960" WindowStartupLocation="CenterScreen" Background="#FCF8FC">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="TrainBtn" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧侧边导航栏 完全原样不变 -->
        <Border Background="White" Margin="0,0,4,0" Padding="12" Width="227" HorizontalAlignment="Left">
            <StackPanel Width="220">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="10" CornerRadius="10,10,10,10" Background="White" BorderBrush="#F7D8EE" BorderThickness="2" Width="204" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountCircle" Width="48" Height="48" Foreground="#7744EE"/>
                        <StackPanel Margin="10,0">
                            <TextBlock Text="用户4438" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="胜兵先胜而后求战,..." FontSize="12" Foreground="#777777" TextWrapping="Wrap" Width="130"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,0,0,12">
                    <Border Padding="8,6" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" Width="18" Height="18" Foreground="#444444"/>
                            <TextBlock Style="{StaticResource NavText}" Text="K线训练"/>
                            <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" Foreground="#888888" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F7E6F7" CornerRadius="6" Padding="8,6" Margin="12,10,0,0" Height="32">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Gamepad" Width="16" Height="16" Foreground="#D848A0"/>
                            <TextBlock Style="{StaticResource NavText}" Text="模拟训练" Foreground="#D848A0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <Border Padding="8,6" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Sword" Width="18" Height="18" Foreground="#444444"/>
                            <TextBlock Style="{StaticResource NavText}" Text="PK对战"/>
                            <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" Foreground="#888888" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="20,6" Cursor="Hand" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBox" Width="16" Height="16" Foreground="#666666"/>
                            <TextBlock Style="{StaticResource NavText}" Text="K线PK" Foreground="#666666"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Margin="0,60,0,0">
                    <Border Padding="8,6" Cursor="Hand" RenderTransformOrigin="1.139,0.373" Margin="0,553,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" Foreground="#444444"/>
                            <TextBlock Style="{StaticResource NavText}" Text="设置"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 中间主内容区域 -->
        <Grid Grid.Column="1" Margin="4,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="380"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 第一行：模拟卡片 | 曲线卡片 -->
            <Grid VerticalAlignment="Top" Margin="0,-19,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="69"/>
                    <ColumnDefinition Width="271"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 模拟训练深色卡片 -->
                <Border Style="{StaticResource CardStyle}" Grid.ColumnSpan="2" Margin="8,27,8,56">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF030629"/>
                            <GradientStop Color="#FF020529" Offset="1"/>
                            <GradientStop Color="#FF1C2482" Offset="0.535"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border Padding="20" Margin="-6,-23,6,-12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55*"/>
                                    <ColumnDefinition Width="71*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模拟训练" FontSize="20" Foreground="White" FontWeight="SemiBold" Grid.ColumnSpan="2"/>
                                <TextBlock Text="爆竹: 10,000" FontSize="20" Foreground="White" HorizontalAlignment="Left" Grid.Column="1" Margin="28,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,30,0,24" Height="137">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55*"/>
                                    <ColumnDefinition Width="29*"/>
                                    <ColumnDefinition Width="84*"/>
                                    <ColumnDefinition Width="84*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Grid.ColumnSpan="2">
                                    <TextBlock Text="训练场次" Foreground="#EEEEEE" FontSize="15" Margin="0,-49,0,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="0" Foreground="White" FontSize="20" Margin="0,-27,0,0" VerticalAlignment="Top"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Medal" Width="78" Height="75" Foreground="#D0D8FF"/>
                                    <TextBlock Text="白银小账户" Foreground="#D0D8FF" FontSize="14" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="排行榜" Foreground="#EEEEEE" FontSize="15" Margin="38,-47,0,0"/>
                                    <TextBlock Text="第 1000+ 名" Foreground="White" FontSize="15" Margin="0,-24,0,0" VerticalAlignment="Top"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,-39,0,28" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Star" Width="10" Height="10" Foreground="#FFD770" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon Kind="StarOutline" Width="10" Height="10" Foreground="#777799" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon Kind="StarOutline" Width="10" Height="10" Foreground="#777799" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon Kind="StarOutline" Width="10" Height="10" Foreground="#777799" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon Kind="StarOutline" Width="10" Height="10" Foreground="#777799"/>
                            </StackPanel>
                            <Grid Height="62" Margin="0,-22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63*"/>
                                    <ColumnDefinition Width="62*"/>
                                    <ColumnDefinition Width="64*"/>
                                    <ColumnDefinition Width="63*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel HorizontalAlignment="Center" Width="40">
                                    <TextBlock Text="0日" Foreground="White" FontSize="12"/>
                                    <TextBlock Text="持仓时间" Foreground="#DDDDDD" FontSize="12" Margin="-11,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Width="30">
                                    <TextBlock Text="0.00%" Foreground="White" FontSize="12" Margin="-7,0,0,0"/>
                                    <TextBlock Text="总胜率" Foreground="#DDDDDD" FontSize="12" Margin="-11,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Width="40">
                                    <TextBlock Text="0" Foreground="White" FontSize="12" Margin="11,0,1,0"/>
                                    <TextBlock Text="暴富次数" Foreground="#DDDDDD" FontSize="12" Margin="-9,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Width="40">
                                    <TextBlock Text="0" Foreground="White" FontSize="12" Margin="11,0,0,0"/>
                                    <TextBlock Text="破产次数" Foreground="#DDDDDD" FontSize="12" Margin="-9,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- 右侧曲线卡片：内部统一用StackPanel承载多子元素，修复Child重复报错 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,27,8,-195">
                    <StackPanel>
                        <!-- 曲线独立布局区域 -->
                        <StackPanel>
                            <Grid>
                                <StackPanel HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,10">
                                <TextBlock Text="爆竹数量曲线" FontSize="15"/>
                                <TextBlock Text="暂无重置周期" FontSize="13" Foreground="#777777" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Background="#F8F8FA" Height="276" CornerRadius="6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Foreground="#CCCCCC" FontSize="22"/>
                                    <TextBlock Text="无缓存数据" FontSize="16" Margin="0,8"/>
                                    <TextBlock Text="训练一把试试" Foreground="#888888"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- 底部提示独立布局 -->
                        <Border Background="#FFF0F8" CornerRadius="6" Margin="0,149,0,0" Padding="10,8" Panel.ZIndex="-4">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="6" Height="6" Background="#E84070" CornerRadius="3" Margin="0,0,6,0"/>
                                    <TextBlock Text="重置期间 -- " Foreground="#555555"/>
                                </StackPanel>
                                <TextBlock Text="共 0 场训练" HorizontalAlignment="Right" Foreground="#555555"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 第二行：训练按钮 + 训练数据 -->
            <Grid Grid.Row="1" Margin="0,10,0,-10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="311*"/>
                    <ColumnDefinition Width="52*"/>
                    <ColumnDefinition Width="249*"/>
                </Grid.ColumnDefinitions>

                <!-- 训练按钮独立布局容器（内部StackPanel承载多按钮，无Child冲突） -->
                <Border Style="{StaticResource CardStyle}" Margin="4,-86,307,0" Width="340" Grid.ColumnSpan="2">
                    <StackPanel>
                        <Border Style="{StaticResource TrainBtn}" Background="#4070F0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="盲盘训练" FontSize="15" Foreground="White" FontWeight="SemiBold"
           Cursor="Hand" MouseLeftButtonUp="OpenDoubleBlindTrain_Click"/>
                                    <TextBlock Text="随机 A 股双盲训练" FontSize="12" Foreground="#E8F0FF"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="Clock" Width="22" Height="22" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TrainBtn}" Background="#FFAA20">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="涨停训练" FontSize="15" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="随机涨停板训练" FontSize="12" Foreground="#FFF8E8"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="ChartLine" Width="22" Height="22" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TrainBtn}" Background="#E84070">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="指数训练" FontSize="15" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="随机指数双盲训练" FontSize="12" Foreground="#FFE8F0"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="ChartBox" Width="22" Height="22" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TrainBtn}" Background="#20A0E8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="期货训练" FontSize="15" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="随机期货双盲训练" FontSize="12" Foreground="#E8F8FF"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="HelpCircle" Width="22" Height="22" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TrainBtn}" Background="#FF8830">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="港股训练" FontSize="15" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="随机港股双盲训练" FontSize="12" Foreground="#FFF0E8"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="Web" Width="22" Height="22" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TrainBtn}" Background="#28D0B0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="美股训练" FontSize="15" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="随机美股双盲训练" FontSize="12" Foreground="#E8FFFB"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="Web" Width="22" Height="22" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TrainBtn}" Background="#9040D0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="可转债训练" FontSize="15" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="随机可转债双盲训练" FontSize="12" Foreground="#F4E8FF"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="FileDocument" Width="22" Height="22" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TrainBtn}" Background="#3050D0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="ETF 训练" FontSize="15" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="随机 ETF 双盲训练" FontSize="12" Foreground="#E8EEFF"/>
                                </StackPanel>
                                <materialDesign:PackIcon Kind="Grid" Width="22" Height="22" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 训练数据独立布局容器，内部StackPanel承载表格 -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,194,8,0" Grid.ColumnSpan="3">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="训练数据" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="训练结果：--" HorizontalAlignment="Right" Foreground="#777777"/>
                        </Grid>
                        <Grid Margin="0,12" Height="461">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24.44"/>
                                <RowDefinition Height="11.56"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <Border Background="#3F51B5" CornerRadius="4" Width="278" Height="46" Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="训练场次：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="15"/>
                            </Border>
                            <Border Grid.Column="1" Background="#3F51B5" CornerRadius="4" Margin="2,0,2,0" Height="46" VerticalAlignment="Top" Grid.RowSpan="3">
                                <TextBlock Text="训练胜率：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="15" Margin="-10,0,0,0"/>
                            </Border>
                            <Border Grid.Row="3" Background="#3F51B5" CornerRadius="4" Margin="0,6,0,20" Grid.RowSpan="2" Height="46" HorizontalAlignment="Left" Width="278">
                                <TextBlock Text="跑赢区间率：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="15" Margin="10,0,0,0"/>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="1" Background="#3F51B5" CornerRadius="4" Margin="2,6,2,0" Grid.RowSpan="2" Height="46" VerticalAlignment="Top">
                                <TextBlock Text="训练盈亏比：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="15"/>
                            </Border>
                            <Border Grid.Row="5" Background="#3F51B5" CornerRadius="4" Margin="0,0,4,18" Height="44" Grid.RowSpan="2" VerticalAlignment="Bottom">
                                <TextBlock Text="持仓时间：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="15"/>
                            </Border>
                            <Border Grid.Row="5" Grid.Column="1" Background="#3F51B5" CornerRadius="4" Margin="4,10,0,0" Height="44" VerticalAlignment="Top" Grid.RowSpan="2">
                                <TextBlock Text="持仓率：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="15" Margin="-24,0,0,0"/>
                            </Border>
                            <Border Grid.Row="6" Background="#3F51B5" CornerRadius="4" Margin="0,50,4,-57">
                                <TextBlock Text="重仓率：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="15" Margin="-10,0,0,0"/>
                            </Border>
                            <Border Grid.Row="6" Grid.Column="1" Background="#3F51B5" CornerRadius="4" Margin="2,50,2,-57">
                                <TextBlock Text="训练耗时：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="15" Margin="-8,0,0,0"/>
                            </Border>
                            <Border Grid.Row="6" Background="#3F51B5" CornerRadius="4" Margin="0,159,4,-155">
                                <TextBlock Text="开仓次数：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                            </Border>
                            <Border Grid.Row="6" Grid.Column="1" Background="#3F51B5" CornerRadius="4" Margin="2,159,2,-155">
                                <TextBlock Text="开仓胜率：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                            </Border>
                            <Border Grid.Row="6" Background="#3F51B5" CornerRadius="4" Margin="-6,239,10,-235">
                                <TextBlock Text="最大盈利：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                            </Border>
                            <Border Grid.Row="6" Grid.Column="1" Background="#3F51B5" CornerRadius="4" Margin="0,239,4,-235">
                                <TextBlock Text="最大回撤：--" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 右侧排行榜 完全原样无修改 -->
        <Border Grid.Column="2" Margin="4,0,0,0">
            <StackPanel>
                <Border CornerRadius="10" Padding="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF7040"/>
                            <GradientStop Color="#FF3070"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Crown" Width="90" Height="90" Foreground="#FFE070"/>
                        <TextBlock Text="收益排行榜" FontSize="26" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="2026年第2季度" FontSize="14" Foreground="#FFF8C0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <Border Background="#7744EE" CornerRadius="6" Padding="10,6" Width="90">
                        <TextBlock Text="季榜" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="#EEEEF8" CornerRadius="6" Padding="10,6" Width="90" Margin="6,0">
                        <TextBlock Text="月榜" Foreground="#666666" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Background="#EEEEF8" CornerRadius="6" Padding="10,6" Width="90" Margin="6,0">
                        <TextBlock Text="周榜" Foreground="#666666" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Border Background="#282050" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="2" FontSize="16" Foreground="#FFD770" VerticalAlignment="Center"/>
                            <materialDesign:PackIcon Kind="AccountCircle" Grid.Column="1" Width="48" Height="48" Foreground="White"/>
                            <StackPanel Grid.Column="2" Margin="8,0">
                                <TextBlock Text="大荣州" Foreground="White" FontSize="14"/>
                                <TextBlock Text="25.66万 爆竹" Foreground="#CCCCCC" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="#503090" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                        <TextBlock Text="x519" FontSize="10" Foreground="#DDDDDD"/>
                                    </Border>
                                    <Border Background="#304080" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                        <TextBlock Text="x6" FontSize="10" Foreground="#DDDDDD"/>
                                    </Border>
                                    <Border Background="#306080" CornerRadius="4" Padding="4,2">
                                        <TextBlock Text="x0" FontSize="10" Foreground="#DDDDDD"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="1" FontSize="16" Foreground="#FFD770" VerticalAlignment="Center"/>
                            <materialDesign:PackIcon Kind="AccountCircle" Grid.Column="1" Width="48" Height="48" Foreground="White"/>
                            <StackPanel Grid.Column="2" Margin="8,0">
                                <TextBlock Text="法利亚神父" Foreground="White" FontSize="14"/>
                                <TextBlock Text="74.77万 爆竹" Foreground="#CCCCCC" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="#503090" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                        <TextBlock Text="x723" FontSize="10" Foreground="#DDDDDD"/>
                                    </Border>
                                    <Border Background="#304080" CornerRadius="4" Padding="4,2" Margin="0,0,4,0">
                                        <TextBlock Text="x6" FontSize="10" Foreground="#DDDDDD"/>
                                    </Border>
                                    <Border Background="#306080" CornerRadius="4" Padding="4,2">
                                        <TextBlock Text="x0" FontSize="10" Foreground="#DDDDDD"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
