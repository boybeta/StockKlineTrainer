<Window x:Class="StockKLineTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="爆竹K线训练助手"
        Width="1400"
        Height="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="PeriodBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PeriodBtnActive" TargetType="Button" BasedOn="{StaticResource PeriodBtn}">
            <Setter Property="Background" Value="#E91E63"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SpeedBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#666"/>
        </Style>

        <Style x:Key="SpeedBtnActive" TargetType="Button" BasedOn="{StaticResource SpeedBtn}">
            <Setter Property="Background" Value="#E91E63"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#E91E63"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧主区域 ==================== -->
        <!-- ← 改动1：固定宽度1050，左对齐 -->
        <Grid Grid.Column="0" Margin="10,10,5,10" Width="1040" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="48"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="500"/>
                <!-- ← 改动2：K线主图固定500px -->
                <RowDefinition Height="100"/>
                <!-- ← 改动3：VOL固定100px -->
                <RowDefinition Height="100"/>
                <!-- ← 改动4：MACD固定100px -->
            </Grid.RowDefinitions>

            <!-- 1. 标题栏 -->
            <!-- 1. 标题栏 -->
            <Border Grid.Row="0" Background="White" CornerRadius="6" Margin="0,0,0,6">
                <DockPanel VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Images/logo.png" Height="32" Margin="10,0"/>
                    <TextBlock Text="爆竹K线训练" FontSize="16" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="8,0"/>
                </DockPanel>
            </Border>


            <!-- 2. 股票信息栏 -->
            <!-- 2. 股票信息栏 -->
            <!-- 2. 股票信息栏 -->
            <Border Grid.Row="1" Background="White" CornerRadius="6" Margin="0,0,0,6"
        BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>

                    <!-- 第1列：状态 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0">
                        <TextBlock Text="进行中" FontSize="12" Foreground="#E91E63" FontWeight="Bold"/>
                        <TextBlock Text="股票" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- 粉色分隔线 -->
                    <Border Grid.Column="1" Background="#999" Width="1" Margin="0,0"/>

                    <!-- 现价 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0">
                        <TextBlock Text="{Binding CurrentPrice, FallbackValue=--}" FontSize="14" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left"/>
                        <TextBlock Text="现价" FontSize="11" Foreground="#999" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="3" Background="#999" Width="1" Margin="0,0"/>

                    <!-- 涨跌 -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0">
                        <TextBlock Text="{Binding PriceChange, StringFormat={}{0:F2}, FallbackValue=--}" FontSize="14" FontWeight="Bold" Foreground="{Binding PriceChangeBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="涨跌" FontSize="11" Foreground="#999" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="5" Background="#999" Width="1" Margin="0,0"/>

                    <!-- 涨跌幅 -->
                    <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0">
                        <TextBlock Text="{Binding PriceChangePct, StringFormat={}{0:F2}%, FallbackValue=--}" FontSize="14" FontWeight="Bold" Foreground="{Binding PriceChangeBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="涨跌幅" FontSize="11" Foreground="#999" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="7" Background="#999" Width="1" Margin="0,0"/>

                    <!-- 开盘 -->
                    <StackPanel Grid.Column="8" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0">
                        <TextBlock Text="{Binding OpenPrice, FallbackValue=--}" FontSize="14" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left"/>
                        <TextBlock Text="开盘" FontSize="11" Foreground="#999" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="9" Background="#999" Width="1" Margin="0,0"/>

                    <!-- 最高 -->
                    <StackPanel Grid.Column="10" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0">
                        <TextBlock Text="{Binding HighPrice, FallbackValue=--}" FontSize="14" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left"/>
                        <TextBlock Text="最高" FontSize="11" Foreground="#999" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="11" Background="#999" Width="1" Margin="0,0"/>

                    <!-- 最低 -->
                    <StackPanel Grid.Column="12" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0">
                        <TextBlock Text="{Binding LowPrice, FallbackValue=--}" FontSize="14" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left"/>
                        <TextBlock Text="最低" FontSize="11" Foreground="#999" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="13" Background="#999" Width="1" Margin="0,0"/>

                    <!-- 量比 -->
                    <StackPanel Grid.Column="14" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0">
                        <TextBlock Text="0.52" FontSize="14" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left"/>
                        <TextBlock Text="量比" FontSize="11" Foreground="#999" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="15" Background="#999" Width="1" Margin="0,0"/>

                    <!-- 换手 -->
                    <StackPanel Grid.Column="16" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,0,0">
                        <TextBlock Text="2.0" FontSize="14" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left"/>
                        <TextBlock Text="换手" FontSize="11" Foreground="#999" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="17" Background="#999" Width="1" Margin="0,0"/>

                    <!-- 日期 -->
                    <StackPanel Grid.Column="18" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                        <TextBlock Text="xxxx-xx" FontSize="13" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left"/>
                        <TextBlock Text="日期" FontSize="11" Foreground="#999" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. 周期切换 -->
            <Border Grid.Row="2" Background="White" CornerRadius="6" Margin="0,0,0,6" Padding="0,0,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="日" Style="{StaticResource PeriodBtnActive}"/>
                    <Button Content="周" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="月" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="分时" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="1分" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="5分" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="15分" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="30分" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="60分" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="✎" Width="32" Style="{StaticResource PeriodBtn}" Margin="12,0,3,0" FontSize="14"/>
                    <Button Content="☰" Width="32" Style="{StaticResource PeriodBtn}" Margin="3,0" FontSize="14"/>
                    <Button Content="⚙" Width="32" Style="{StaticResource PeriodBtn}" Margin="3,0,0,0" FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- 4. K线主图 -->
            <!-- ← 改动5：去掉底部Margin，与VOL紧密相连 -->
            <!-- 4. K线主图 -->
            <Border Grid.Row="3" Background="White" CornerRadius="6" Margin="0,0,0,0"
        BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <!-- 左上角指标文字（浮在K线图内部左上角） -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,26" Panel.ZIndex="1">
                        <TextBlock FontSize="11">
                <Run Text="MA(5,10,20)  " Foreground="#999"/>
                <Run Text="MA5:" Foreground="#999"/>
                <Run Text="{Binding MA5Value, FallbackValue=--}" Foreground="#FFD700" FontWeight="Bold"/>
                <Run Text=" " Foreground="#999"/>
                <Run Text="MA10:" Foreground="#999"/>
                <Run Text="{Binding MA10Value, FallbackValue=--}" Foreground="#00BFFF" FontWeight="Bold"/>
                <Run Text=" " Foreground="#999"/>
                <Run Text="MA20:" Foreground="#999"/>
                <Run Text="{Binding MA20Value, FallbackValue=--}" Foreground="#FF69B4" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Margin="0,3,0,0">
                <Run Text="EMA(5,10,20) " Foreground="#999"/>
                <Run Text="EMA5:" Foreground="#999"/>
                <Run Text="{Binding EMA5Value, FallbackValue=--}" Foreground="#FFD700" FontWeight="Bold"/>
                <Run Text=" " Foreground="#999"/>
                <Run Text="EMA10:" Foreground="#999"/>
                <Run Text="{Binding EMA10Value, FallbackValue=--}" Foreground="#00BFFF" FontWeight="Bold"/>
                <Run Text=" " Foreground="#999"/>
                <Run Text="EMA20:" Foreground="#999"/>
                <Run Text="{Binding EMA20Value, FallbackValue=--}" Foreground="#FF69B4" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Margin="0,3,0,0">
                <Run Text="BOLL(20,2)   " Foreground="#999"/>
                <Run Text="UP:" Foreground="#999"/>
                <Run Text="{Binding BollUpValue, FallbackValue=--}" Foreground="#FF69B4" FontWeight="Bold"/>
                <Run Text=" " Foreground="#999"/>
                <Run Text="MID:" Foreground="#999"/>
                <Run Text="{Binding BollMidValue, FallbackValue=--}" Foreground="#00BFFF" FontWeight="Bold"/>
                <Run Text=" " Foreground="#999"/>
                <Run Text="DN:" Foreground="#999"/>
                <Run Text="{Binding BollDnValue, FallbackValue=--}" Foreground="#00A800" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- K线图：顶部Margin改为0，让指标文字浮在图内部 -->
                    <scottplot:WpfPlot x:Name="KlinePlot" Margin="10,0,10,0"/>
                </Grid>
            </Border>

            <!-- 5. VOL副图 -->
            <!-- ← 改动7：去掉底部Margin，与MACD紧密相连 -->
            <Border Grid.Row="4" Background="White" CornerRadius="6" Margin="0,0,0,0"
        BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,4" Panel.ZIndex="1">
                        <TextBlock FontSize="11">
                            <Run Text="VOL(5,10) " Foreground="#999"/>
                            <Run Text="MA5:" Foreground="#999"/>
                            <Run Text="{Binding VolMA5Value, FallbackValue=--}" Foreground="#FFD700" FontWeight="Bold"/>
                            <Run Text=" " Foreground="#999"/>
                            <Run Text="MA10:" Foreground="#999"/>
                            <Run Text="{Binding VolMA10Value, FallbackValue=--}" Foreground="#00BFFF" FontWeight="Bold"/>
                            <Run Text=" " Foreground="#999"/>
                            <Run Text="VOLUME:" Foreground="#999"/>
                            <Run Text="{Binding VolumeValue, FallbackValue=--}" Foreground="#333" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                    <!-- ← 改动8：左边距从40改为10 -->
                    <scottplot:WpfPlot x:Name="VolPlot" Margin="10,0,10,0"/>
                </Grid>
            </Border>

            <!-- 6. MACD副图 -->
            <Border Grid.Row="5" Background="White" CornerRadius="6"
        BorderBrush="#DDD" BorderThickness="1">
                <!-- ← 改动9：简化内部Grid，去掉无意义的ColumnDefinitions，统一左边距 -->
                <Grid>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,4" Panel.ZIndex="1">
                        <TextBlock FontSize="11">
                            <Run Text="MACD(12,26,9) " Foreground="#999"/>
                            <Run Text="DIF:" Foreground="#999"/>
                            <Run Text="{Binding DIFValue, FallbackValue=--}" Foreground="#FFD700" FontWeight="Bold"/>
                            <Run Text=" " Foreground="#999"/>
                            <Run Text="DEA:" Foreground="#999"/>
                            <Run Text="{Binding DEAValue, FallbackValue=--}" Foreground="#00BFFF" FontWeight="Bold"/>
                            <Run Text=" " Foreground="#999"/>
                            <Run Text="MACD:" Foreground="#999"/>
                            <Run Text="{Binding MACDValue, FallbackValue=--}" Foreground="#FF69B4" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                    <!-- ← 改动10：左边距从40改为10 -->
                    <scottplot:WpfPlot x:Name="MacdPlot" Margin="10,0,10,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 右侧信息面板 ==================== -->
        <Border Grid.Column="1" Background="White" Margin="5,10,10,10" CornerRadius="6" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 内容区域 -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" Margin="0,-60,0,0">
                    <StackPanel>

                        <!-- 训练信息 -->
                        <TextBlock Text="训练信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="总爆竹" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalFirecrackers, StringFormat=F2, FallbackValue=10000.00}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="使用爆竹数量" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UsedFirecrackers, StringFormat=F2, FallbackValue=0.00}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="未使用爆竹数量" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UnusedFirecrackers, StringFormat=F2, FallbackValue=10000.00}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="本局收益" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalProfitAmount, StringFormat={}{0:F2}, FallbackValue=0.00}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{Binding TotalProfitBrush}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="开仓收益" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OpenProfitAmount, StringFormat={}{0:F2}, FallbackValue=0.00}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{Binding OpenProfitBrush}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="成本价" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AvgCostPriceText, FallbackValue=--}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="#999"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="持仓" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding PositionText, FallbackValue=0/1}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="T+1冻结" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding FrozenText, FallbackValue=0}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,0,0,10"/>

                        <!-- 训练数据 -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="训练数据" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="{Binding RemainingBars, StringFormat=剩余 {0} 根, FallbackValue=剩余 150 根}" FontSize="11" Foreground="#999" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding OpenCount, FallbackValue=0}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="开仓次数" FontSize="12" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding ProfitCount, FallbackValue=0}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="盈利次数" FontSize="12" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding WatchDays, FallbackValue=0}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="观望天数" FontSize="12" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding HoldDays, FallbackValue=0}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="持仓天数" FontSize="12" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding HeavyHoldDays, FallbackValue=0}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="重仓天数" FontSize="12" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="{Binding ElapsedText, FallbackValue=0s}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="用时" FontSize="12" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Separator Margin="0,0,0,10"/>

                        <!-- 操作 -->
                        <TextBlock Text="操作" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                        <!-- 买入/卖出 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Margin="0,0,3,0" Height="48" BorderThickness="0" FontWeight="Bold"
        Command="{Binding BuyCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#E91E63"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#E91E63"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="B" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="买入" FontSize="16"/>
                                        <TextBlock Text="{Binding BuyBtnSubText, FallbackValue=可买1/1仓}" FontSize="10" Opacity="0.85" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Margin="3,0,0,0" Height="48" BorderThickness="0" FontWeight="Bold"
        Command="{Binding SellCommand}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#FF0E5B11"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#FF0E5B11"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="S" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="卖出" FontSize="16"/>
                                        <TextBlock Text="{Binding SellBtnSubText, FallbackValue=无仓位可卖}" FontSize="10" Opacity="0.85" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 持有/观望 -->
                        <Button Height="42" Margin="0,0,0,8" BorderThickness="0" FontWeight="Bold"
                                Command="{Binding HoldOrWatchCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#FF4081"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="Black"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#333333"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="持有 / 观望" FontSize="14"/>
                                <TextBlock Text="H / Space" FontSize="10" Opacity="0.7" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 自动播放 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="自动播放" Width="85" Height="36"
                                    Background="#4A90D9" Foreground="White"
                                    FontSize="12" FontWeight="Bold" BorderThickness="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="0.5x" Width="40" Height="28" Margin="2,0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" FontSize="11"/>
                                <Button Content="1x" Width="40" Height="28" Margin="2,0" Background="#E91E63" Foreground="White" BorderThickness="0" FontSize="11"/>
                                <Button Content="2x" Width="40" Height="28" Margin="2,0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" FontSize="11"/>
                                <Button Content="4x" Width="40" Height="28" Margin="2,0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,0,0,10"/>

                        <!-- 操作流水 -->
                        <TextBlock Text="操作流水" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                        <Border Background="#F8F8F8" CornerRadius="4" Padding="0" MinHeight="50">
                            <Grid>
                                <!-- 空数据提示 -->
                                <TextBlock Text="暂无操作" Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TradeRecords.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- 流水列表 -->
                                <ItemsControl ItemsSource="{Binding TradeRecords}" Margin="8,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="0,6">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Type}" FontSize="13" FontWeight="Bold" Foreground="#333"/>
                                                        <TextBlock Text="{Binding Date}" FontSize="11" Foreground="#999" HorizontalAlignment="Right"/>
                                                    </DockPanel>
                                                    <TextBlock Margin="0,2,0,0">
                                                        <Run Text="{Binding Price, StringFormat={}{0:F2}}" FontSize="12" Foreground="#666"/>
                                                        <Run Text=" · " Foreground="#CCC"/>
                                                        <Run Text="{Binding Profit}" FontSize="12" FontWeight="Bold" Foreground="#E91E63"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- 底部留白 -->
                        <Border Height="20"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- 结束训练并结算 - 固定在底部 -->
                <Button Grid.Row="1" Height="44" Margin="0,10,0,0"
        FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
        Command="{Binding SettleCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2C3E50"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#2C3E50"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    结束训练并结算
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>