<Window x:Class="BaozhuKLineTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="火星币K线训练助手" Width="1500" Height="960" WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Bg.Window}">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.Card}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="TrainBtn" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>

        <!-- 导航分组头：图标+文字+箭头，展开时箭头旋转180° -->
        <Style x:Key="NavGroupHeaderStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg.Secondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <DockPanel Margin="8,0">
                                <ContentPresenter DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14"
                                                 Foreground="{DynamicResource Fg.Muted}" VerticalAlignment="Center"
                                                 HorizontalAlignment="Right">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <RotateTransform CenterX="7" CenterY="7"/>
                                    </materialDesign:PackIcon.RenderTransform>
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                     Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180" CenterX="7" CenterY="7"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Bg.Control}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导航子项：缩进圆点+文字，默认透明，悬停浅灰；选中态由代码后置刷粉色 -->
        <Style x:Key="NavItemStyle" TargetType="Border">
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="14,8,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Bg.Control}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 自绘标题栏（WindowStyle=None 后替代系统标题栏） ==================== -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource Bg.Window}"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <TextBlock Text="火星币K线训练助手" FontSize="12"
                           Foreground="{DynamicResource Fg.Secondary}"
                           VerticalAlignment="Center" Margin="12,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMinimize" Width="46" Height="32"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="最小化" Click="BtnMinimize_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Bg.Control}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="13" Height="13"
                                                 Foreground="{DynamicResource Fg.Secondary}"/>
                    </Button>
                    <Button x:Name="BtnClose" Width="46" Height="32"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="关闭" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="Close" Width="13" Height="13"
                                                 Foreground="{DynamicResource Fg.Secondary}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 左侧侧边导航栏（重构：可折叠菜单 + 设置自然贴底） ==================== -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Bg.Card}" Margin="0,0,4,0" Padding="12" Width="227" HorizontalAlignment="Left">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 用户卡片 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 搜索框 -->
                    <RowDefinition Height="*"/>
                    <!-- 菜单（可滚动） -->
                    <RowDefinition Height="Auto"/>
                    <!-- 设置（贴底） -->
                </Grid.RowDefinitions>

                <!-- ① 用户卡片：圆形头像 + 昵称 + 状态 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="10"
                        CornerRadius="10" Background="{DynamicResource Bg.Card}" BorderBrush="#F7D8EE" BorderThickness="2">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="48" Height="48">
                            <Ellipse Fill="#EEEEEE"/>
                            <!-- 无头像图片时露出默认图标 -->
                            <materialDesign:PackIcon Kind="AccountCircle" Width="48" Height="48" Foreground="#7744EE"/>
                            <!-- 头像：E:\baozhu\userdata\avatar.png 存在则覆盖上图标 -->
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="AvatarImage" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="用户4438" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"/>
                            <TextBlock Text="胜兵先胜而后求战,..." FontSize="12" Foreground="{DynamicResource Fg.Muted}"
                                       TextWrapping="Wrap" Width="110"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ② 搜索框 -->
                <Border Grid.Row="1" Background="{DynamicResource Bg.Control}" CornerRadius="8" Height="36" Margin="0,0,0,8">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource Fg.Muted}"
                                                 VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="12" Margin="8,0,0,0"
                                 materialDesign:HintAssist.Hint="搜索股票 / 指数 / 期货 ..."/>
                    </Grid>
                </Border>

                <!-- ③ 菜单区：5 个可折叠分组 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel>

                        <!-- K线训练 -->
                        <ToggleButton x:Name="GrpTrain" Style="{StaticResource NavGroupHeaderStyle}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartLine" Width="18" Height="18" Foreground="{DynamicResource Fg.Secondary}"/>
                                <TextBlock Text="K线训练" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"  Foreground="{DynamicResource Fg.Primary}"/>
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel Visibility="{Binding IsChecked, ElementName=GrpTrain, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource NavItemStyle}" Background="#F7D8EE"
                                    MouseLeftButtonUp="NavItem_Click" Tag="nav:SimTrain">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <Ellipse Width="4" Height="4" Fill="#D848A0" VerticalAlignment="Center"/>
                                    <TextBlock Text="模拟训练" FontSize="13" Foreground="#D848A0"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItemStyle}"
                                    MouseLeftButtonUp="NavItem_Click" Tag="nav:AssignTrain">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <Ellipse Width="4" Height="4" Fill="#999999" VerticalAlignment="Center"/>
                                    <TextBlock Text="指定训练" FontSize="13" Foreground="{DynamicResource Fg.Secondary}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItemStyle}"
                                    MouseLeftButtonUp="NavItem_Click" Tag="nav:Favorite">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <Ellipse Width="4" Height="4" Fill="#999999" VerticalAlignment="Center"/>
                                    <TextBlock Text="我的收藏" FontSize="13" Foreground="{DynamicResource Fg.Secondary}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- PK对战 -->
                        <ToggleButton x:Name="GrpPK" Style="{StaticResource NavGroupHeaderStyle}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sword" Width="18" Height="18" Foreground="{DynamicResource Fg.Secondary}"/>
                                <TextBlock Text="PK对战" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"/>
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel Visibility="{Binding IsChecked, ElementName=GrpPK, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource NavItemStyle}"
                                    MouseLeftButtonUp="NavItem_Click" Tag="nav:KlinePK">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <Ellipse Width="4" Height="4" Fill="#999999" VerticalAlignment="Center"/>
                                    <TextBlock Text="K线PK" FontSize="13" Foreground="{DynamicResource Fg.Secondary}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 预测选股 -->
                        <ToggleButton x:Name="GrpPredict" Style="{StaticResource NavGroupHeaderStyle}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AutoFix" Width="18" Height="18" Foreground="{DynamicResource Fg.Secondary}"/>
                                <TextBlock Text="预测选股" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"/>
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel Visibility="{Binding IsChecked,ElementName=GrpPredict, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource NavItemStyle}"
                                    MouseLeftButtonUp="NavItem_Click" Tag="nav:PredictUp">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <Ellipse Width="4" Height="4" Fill="#999999" VerticalAlignment="Center"/>
                                    <TextBlock Text="涨跌预测" FontSize="13" Foreground="{DynamicResource Fg.Secondary}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItemStyle}"
                                    MouseLeftButtonUp="NavItem_Click" Tag="nav:PatternPick">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <Ellipse Width="4" Height="4" Fill="#999999" VerticalAlignment="Center"/>
                                    <TextBlock Text="形态选股" FontSize="13" Foreground="{DynamicResource Fg.Secondary}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 战法复盘 -->
                        <ToggleButton x:Name="GrpReview" Style="{StaticResource NavGroupHeaderStyle}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="NotebookOutline" Width="18" Height="18" Foreground="{DynamicResource Fg.Secondary}"/>
                                <TextBlock Text="战法复盘" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"/>
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel Visibility="{Binding IsChecked,ElementName=GrpReview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Style="{StaticResource NavItemStyle}"
                                    MouseLeftButtonUp="NavItem_Click" Tag="nav:Strategy">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <Ellipse Width="4" Height="4" Fill="#999999" VerticalAlignment="Center"/>
                                    <TextBlock Text="战法打磨" FontSize="13" Foreground="{DynamicResource Fg.Secondary}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItemStyle}"
                                    MouseLeftButtonUp="NavItem_Click" Tag="nav:ReviewNote">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <Ellipse Width="4" Height="4" Fill="#999999" VerticalAlignment="Center"/>
                                    <TextBlock Text="复盘笔记" FontSize="13" Foreground="{DynamicResource Fg.Secondary}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItemStyle}"
                                    MouseLeftButtonUp="NavItem_Click" Tag="nav:TradePlan">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <Ellipse Width="4" Height="4" Fill="#999999" VerticalAlignment="Center"/>
                                    <TextBlock Text="交易计划" FontSize="13" Foreground="{DynamicResource Fg.Secondary}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NavItemStyle}"
                                    MouseLeftButtonUp="NavItem_Click" Tag="nav:Diary">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <Ellipse Width="4" Height="4" Fill="#999999" VerticalAlignment="Center"/>
                                    <TextBlock Text="实盘日记" FontSize="13" Foreground="{DynamicResource Fg.Secondary}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- ④ 设置：Grid 最后一行自然贴底（替代原 Margin 硬编码） -->
                <Border Grid.Row="3" Padding="8,6" Margin="0,8,0,0" CornerRadius="6" Cursor="Hand"
                        Background="Transparent" MouseLeftButtonUp="NavItem_Click" Tag="nav:Setting">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" Foreground="{DynamicResource Fg.Secondary}"/>
                        <TextBlock Text="设置" Style="{StaticResource NavText}" Foreground="{DynamicResource Fg.Secondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 中间主内容区域（以下保持原样不动） ==================== -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="4,0,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="380"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 第一行：模拟卡片 | 曲线卡片 -->
            <Grid VerticalAlignment="Top" Margin="0,-19,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="69"/>
                    <ColumnDefinition Width="271"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 模拟训练深色卡片 -->
                <Border Style="{StaticResource CardStyle}" Grid.ColumnSpan="2" Margin="8,27,8,56">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="#FF030629"/>
                            <GradientStop Color="#FF020529" Offset="1"/>
                            <GradientStop Color="#FF1C2482" Offset="0.535"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border Padding="20" Margin="-6,-23,6,-12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55*"/>
                                    <ColumnDefinition Width="71*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模拟训练" FontSize="20" Foreground="White" FontWeight="SemiBold" Grid.ColumnSpan="2"/>
                                <TextBlock x:Name="TxtFirecracker" Text="火星币: 10,000" FontSize="16" Foreground="White" HorizontalAlignment="Left" Grid.Column="1" Margin="28,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,30,0,24" Height="137">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55*"/>
                                    <ColumnDefinition Width="29*"/>
                                    <ColumnDefinition Width="84*"/>
                                    <ColumnDefinition Width="84*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Grid.ColumnSpan="2">
                                    <TextBlock Text="训练场次" Foreground="#EEEEEE" FontSize="15" Margin="0,-49,0,0" VerticalAlignment="Top"/>
                                    <TextBlock x:Name="TxtTrainCount" Text="0" Foreground="White" FontSize="20" Margin="0,-27,0,0" VerticalAlignment="Top"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- 段位徽章：加载 images\白银小账户.png（透明底，无兜底图标） -->
                                    <Grid Width="100" Height="100" Margin="-20,20,7,0">
                                        <Image x:Name="RankIcon" Width="110" Height="110" Stretch="Uniform" Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtRankName" Text="白银小账户" Foreground="#D0D8FF" FontSize="14" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="排行榜" Foreground="#EEEEEE" FontSize="15" Margin="38,-47,0,0"/>
                                    <TextBlock Text="第 1000+ 名" Foreground="White" FontSize="15" Margin="0,-24,0,0" VerticalAlignment="Top"/>
                                </StackPanel>
                            </Grid>
                            <!-- 段位星标：6 颗对应 6 段，点亮数量 = 段位等级（代码刷新颜色） -->
                            <StackPanel Orientation="Horizontal" Margin="0,-10,0,28" HorizontalAlignment="Center">
                                <materialDesign:PackIcon x:Name="Star1" Kind="Star" Width="10" Height="10" Foreground="#777799" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon x:Name="Star2" Kind="Star" Width="10" Height="10" Foreground="#777799" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon x:Name="Star3" Kind="Star" Width="10" Height="10" Foreground="#777799" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon x:Name="Star4" Kind="Star" Width="10" Height="10" Foreground="#777799" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon x:Name="Star5" Kind="Star" Width="10" Height="10" Foreground="#777799" Margin="0,0,12,0"/>
                                <materialDesign:PackIcon x:Name="Star6" Kind="Star" Width="10" Height="10" Foreground="#777799"/>
                            </StackPanel>
                            <Grid Height="62" Margin="0,-22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="63*"/>
                                    <ColumnDefinition Width="62*"/>
                                    <ColumnDefinition Width="64*"/>
                                    <ColumnDefinition Width="63*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel HorizontalAlignment="Center" Width="40">
                                    <TextBlock x:Name="TxtHoldDays" Text="0日" Foreground="White" FontSize="12"/>
                                    <TextBlock Text="持仓时间" Foreground="#DDDDDD" FontSize="12" Margin="-11,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Width="30">
                                    <TextBlock x:Name="TxtTotalWinRate" Text="0.00%" Foreground="White" FontSize="12" Margin="-7,0,0,0"/>
                                    <TextBlock Text="总胜率" Foreground="#DDDDDD" FontSize="12" Margin="-11,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Width="40">
                                    <TextBlock x:Name="TxtBoomCount" Text="0" Foreground="White" FontSize="12" Margin="11,0,1,0"/>
                                    <TextBlock Text="暴富次数" Foreground="#DDDDDD" FontSize="12" Margin="-9,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Width="40">
                                    <TextBlock x:Name="TxtBrokeCount" Text="0" Foreground="White" FontSize="12" Margin="11,0,0,0"/>
                                    <TextBlock Text="破产次数" Foreground="#DDDDDD" FontSize="12" Margin="-9,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- 右侧曲线卡片 -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,8,-330">
                    <StackPanel>
                        <StackPanel>
                            <Grid>
                                <StackPanel HorizontalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,10">
                                <TextBlock Text="火星币数量曲线" FontSize="15" Foreground="{DynamicResource Fg.Primary}"/>
                                <TextBlock Text="暂无重置周期" FontSize="13" Foreground="{DynamicResource Fg.Muted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Background="{DynamicResource Bg.Control}" Height="276" CornerRadius="6">
                                <Grid>
                                    <scottplot:WpfPlot x:Name="CurvePlot"/>
                                    <TextBlock x:Name="TxtCurveEmpty" Text="暂无训练记录，训练一把试试" FontSize="14" Foreground="{DynamicResource Fg.Muted}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 训练记录列表 -->
                        <StackPanel Margin="0,14,0,0">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="训练记录" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg.Primary}"/>
                                <TextBlock Text="最近 50 场" FontSize="12" Foreground="{DynamicResource Fg.Muted}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="RecordList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Bg.Card}" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="8"
                                                    Padding="12,10" Margin="0,4">
