<Window x:Class="StockKLineTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="爆竹K线训练助手"
        Width="1500"
        Height="900"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- 周期按钮样式 -->
        <Style x:Key="PeriodBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PeriodBtnActive" TargetType="Button" BasedOn="{StaticResource PeriodBtn}">
            <Setter Property="Background" Value="#E91E63"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 操作按钮样式 -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 速度按钮样式 -->
        <Style x:Key="SpeedBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#666"/>
        </Style>

        <Style x:Key="SpeedBtnActive" TargetType="Button" BasedOn="{StaticResource SpeedBtn}">
            <Setter Property="Background" Value="#E91E63"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#E91E63"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧主区域 ==================== -->
        <Grid Grid.Column="0" Margin="10,10,5,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="58"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="105"/>
                <RowDefinition Height="105"/>
            </Grid.RowDefinitions>

            <!-- 1. 标题栏 -->
            <Border Grid.Row="0" Background="White" CornerRadius="6" Margin="0,0,0,6">
                <DockPanel VerticalAlignment="Center">
                    <Button Content="返回" Width="56" Height="28" Margin="10,0"
                            Background="Transparent" BorderBrush="#DDD" BorderThickness="1"
                            FontSize="13" Cursor="Hand"/>
                    <TextBlock Text="爆竹K线训练" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="8,0"/>
                </DockPanel>
            </Border>

            <!-- 2. 股票信息栏 -->
            <Border Grid.Row="1" Background="White" CornerRadius="6" Margin="0,0,0,6" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="进行中" FontSize="12" Foreground="#E91E63" FontWeight="Bold"/>
                        <TextBlock Text="股票" FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="28.61" FontSize="20" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="现价" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="-0.39" FontSize="20" FontWeight="Bold" Foreground="#00A800"/>
                        <TextBlock Text="涨跌" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="-1.28%" FontSize="20" FontWeight="Bold" Foreground="#00A800"/>
                        <TextBlock Text="涨跌幅" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="28.98" FontSize="17" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="开盘" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                        <TextBlock Text="29.01" FontSize="17" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="最高" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                        <TextBlock Text="28.52" FontSize="17" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="最低" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="7" VerticalAlignment="Center">
                        <TextBlock Text="0.54" FontSize="17" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="量比" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="8" VerticalAlignment="Center">
                        <TextBlock Text="0.79%" FontSize="17" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="换手" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="9" VerticalAlignment="Center">
                        <TextBlock Text="xxxx-xx-04" FontSize="17" FontWeight="Bold" Foreground="#333"/>
                        <TextBlock Text="日期" FontSize="11" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. 周期切换 -->
            <Border Grid.Row="2" Background="White" CornerRadius="6" Margin="0,0,0,6" Padding="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="日" Style="{StaticResource PeriodBtnActive}"/>
                    <Button Content="周" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="月" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="分时" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="1分" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="5分" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="15分" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="30分" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="60分" Style="{StaticResource PeriodBtn}"/>
                    <Button Content="✎" Width="32" Style="{StaticResource PeriodBtn}" Margin="12,0,3,0" FontSize="14"/>
                    <Button Content="☰" Width="32" Style="{StaticResource PeriodBtn}" Margin="3,0" FontSize="14"/>
                    <Button Content="⚙" Width="32" Style="{StaticResource PeriodBtn}" Margin="3,0,0,0" FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- 4. K线主图 -->
            <Border Grid.Row="3" Background="White" CornerRadius="6" Margin="0,0,0,6">
                <Grid>
                    <!-- 左上角指标文字 -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,8" Panel.ZIndex="1">
                        <TextBlock FontSize="11">
							<Run Text="MA(5,10,20)  " Foreground="#999"/>
							<Run Text="MA5:" Foreground="#999"/>
							<Run Text="28.57 " Foreground="#FFD700" FontWeight="Bold"/>
							<Run Text="MA10:" Foreground="#999"/>
							<Run Text="28.18 " Foreground="#00BFFF" FontWeight="Bold"/>
							<Run Text="MA20:" Foreground="#999"/>
							<Run Text="27.71" Foreground="#FF69B4" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Margin="0,3,0,0">
							<Run Text="EMA(5,10,20) " Foreground="#999"/>
							<Run Text="EMA5:" Foreground="#999"/>
							<Run Text="28.56 " Foreground="#FFD700" FontWeight="Bold"/>
							<Run Text="EMA10:" Foreground="#999"/>
							<Run Text="28.27 " Foreground="#00BFFF" FontWeight="Bold"/>
							<Run Text="EMA20:" Foreground="#999"/>
							<Run Text="28.03" Foreground="#FF69B4" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Margin="0,3,0,0">
							<Run Text="BOLL(20,2)   " Foreground="#999"/>
							<Run Text="UP:" Foreground="#999"/>
							<Run Text="28.91 " Foreground="#FF69B4" FontWeight="Bold"/>
							<Run Text="MID:" Foreground="#999"/>
							<Run Text="27.71 " Foreground="#00BFFF" FontWeight="Bold"/>
							<Run Text="DN:" Foreground="#999"/>
							<Run Text="26.51" Foreground="#00A800" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- 开始训练按钮 -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,25,0"
                            Background="#4A90D9" Foreground="White" FontSize="13" FontWeight="Bold"
                            BorderThickness="0" Padding="10,4" Panel.ZIndex="1"
                            Command="{Binding ToggleTrainingCommand}">
                        开始
                    </Button>

                    <!-- K线图 -->
                    <scottplot:WpfPlot x:Name="KlinePlot" Margin="40,65,10,0"/>
                </Grid>
            </Border>

            <!-- 5. VOL副图 -->
            <Border Grid.Row="4" Background="White" CornerRadius="6" Margin="0,0,0,20">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,4" Panel.ZIndex="1">
                        <TextBlock FontSize="11">
							<Run Text="VOL(5,10) " Foreground="#999"/>
							<Run Text="MA5:" Foreground="#999"/>
							<Run Text="6.123M " Foreground="#FFD700" FontWeight="Bold"/>
							<Run Text="MA10:" Foreground="#999"/>
							<Run Text="5.586M " Foreground="#00BFFF" FontWeight="Bold"/>
							<Run Text="VOLUME:" Foreground="#999"/>
							<Run Text="4.365M" Foreground="#333" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                    <scottplot:WpfPlot x:Name="VolPlot" Margin="40,0,10,0"/>
                </Grid>
            </Border>

            <!-- 6. MACD副图 -->
            <Border Grid.Row="5" Background="White" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="304*"/>
                        <ColumnDefinition Width="841*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="1" Grid.ColumnSpan="2">
                        <TextBlock FontSize="11">
							<Run Text="MACD(12,26,9) " Foreground="#999"/>
							<Run Text="DIF:" Foreground="#999"/>
							<Run Text="0.1221 " Foreground="#FFD700" FontWeight="Bold"/>
							<Run Text="DEA:" Foreground="#999"/>
							<Run Text="-0.1168 " Foreground="#00BFFF" FontWeight="Bold"/>
							<Run Text="MACD:" Foreground="#999"/>
							<Run Text="0.4778" Foreground="#FF69B4" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                    <scottplot:WpfPlot x:Name="MacdPlot" Margin="40,0,10,0" Grid.ColumnSpan="2"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 右侧信息面板 ==================== -->
        <!-- ==================== 右侧信息面板 ==================== -->
        <!-- ==================== 右侧信息面板 ==================== -->
        <Border Grid.Column="1" Background="White" Margin="5,10,10,10" CornerRadius="6" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 内容区域 -->
                    <RowDefinition Height="*"/>
                    <!-- 底部按钮 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 内容区域 - 使用 ScrollViewer 但隐藏滚动条 -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden" Margin="0,-60,0,0">
                    <StackPanel>

                        <!-- 训练信息 -->
                        <TextBlock Text="训练信息" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="总爆竹" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="8219.07" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="使用爆竹数量" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="8219.07" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="未使用爆竹数量" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="本局收益" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="0.00%" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="#999"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="开仓收益" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="0.00%" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="#999"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="成本价" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="--" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="#999"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="持仓" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="0/1" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="T+1冻结" VerticalAlignment="Center" Foreground="#666" FontSize="12"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Margin="0,0,0,10"/>

                        <!-- 训练数据 -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="训练数据" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Text="剩余 150 根" FontSize="11" Foreground="#999" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="开仓次数" FontSize="10" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="盈利次数" FontSize="10" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="观望天数" FontSize="10" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="持仓天数" FontSize="10" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="0" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="重仓天数" FontSize="10" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="6,5" Margin="2">
                                <StackPanel>
                                    <TextBlock Text="9s" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="用时" FontSize="10" Foreground="#999" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Separator Margin="0,0,0,10"/>

                        <!-- 操作 -->
                        <TextBlock Text="操作" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>

                        <!-- 买入/卖出 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Margin="0,0,3,0" Height="48" Background="#E91E63" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                <StackPanel>
                                    <TextBlock Text="买入" FontSize="16"/>
                                    <TextBlock Text="可买1/1仓" FontSize="10" Opacity="0.85" Margin="0,1,0,0"/>
                                    <TextBlock Text="B" FontSize="9" Opacity="0.6" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Margin="3,0,0,0" Height="48" Background="#81C784" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                <StackPanel>
                                    <TextBlock Text="卖出" FontSize="16"/>
                                    <TextBlock Text="无仓位可卖" FontSize="10" Opacity="0.85" Margin="0,1,0,0"/>
                                    <TextBlock Text="M" FontSize="9" Opacity="0.6" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 持有/观望 -->
                        <Button Height="42" Margin="0,0,0,8" Background="#FF4081" Foreground="White" BorderThickness="0" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="持有 / 观望" FontSize="14"/>
                                <TextBlock Text="H / Space" FontSize="10" Opacity="0.7" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- 自动播放 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="自动播放" Width="85" Height="36"
									Background="#4A90D9" Foreground="White"
									FontSize="12" FontWeight="Bold" BorderThickness="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="0.5x" Width="40" Height="28" Margin="2,0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" FontSize="11"/>
                                <Button Content="1x" Width="40" Height="28" Margin="2,0" Background="#E91E63" Foreground="White" BorderThickness="0" FontSize="11"/>
                                <Button Content="2x" Width="40" Height="28" Margin="2,0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" FontSize="11"/>
                                <Button Content="4x" Width="40" Height="28" Margin="2,0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,0,0,10"/>

                        <!-- 操作流水 -->
                        <TextBlock Text="操作流水" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Border Background="#F8F8F8" CornerRadius="4" Padding="15" MinHeight="50">
                            <TextBlock Text="暂无操作" Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                        </Border>

                        <!-- 底部留白，确保内容不被截断 -->
                        <Border Height="20"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- 结束训练并结算 - 固定在底部 -->
                <Button Grid.Row="1" Height="44" Margin="0,10,0,0"
						Background="#2C3E50" Foreground="White"
						FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    结束训练并结算
                </Button>

            </Grid>
        </Border>
    </Grid>
</Window>