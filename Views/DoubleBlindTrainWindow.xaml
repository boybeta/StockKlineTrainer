<Window x:Class="BaozhuKLineTrainer.DoubleBlindTrainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BaozhuKLineTrainer"
        Title="双盲训练"
        Width="720" Height="760"
        MinWidth="720" MinHeight="760"
        MaxWidth="720" MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ChipToggleStyle" TargetType="ToggleButton"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#E6F0FF"/>
                    <Setter Property="BorderBrush" Value="#2E5BFF"/>
                    <Setter Property="Foreground" Value="#2E5BFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChipRadioStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#E6F0FF"/>
                    <Setter Property="BorderBrush" Value="#2E5BFF"/>
                    <Setter Property="Foreground" Value="#2E5BFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 圆形加减按钮 -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E8E8E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Slider 轨道点击区域样式（透明响应点击，或显示蓝色进度） -->
        <Style x:Key="SliderRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" 
                                Height="4" CornerRadius="2" 
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White"
            CornerRadius="16"
            Padding="20"
            Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="#33000000" BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <DockPanel Grid.Row="0"
                       Background="Transparent"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="双盲训练"
                           FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right"
                        Width="36" Height="36"
                        Style="{StaticResource MaterialDesignIconButton}"
                        materialDesign:ButtonAssist.CornerRadius="18"
                        HorizontalAlignment="Right"
                        Click="Close_Click"
                        ToolTip="关闭">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </DockPanel>

            <!-- 内容区 -->
            <ScrollViewer Grid.Row="1"
                          Padding="0,0,0,10"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 说明文字 -->
                    <TextBlock TextWrapping="Wrap"
                               FontSize="12" Foreground="#888"
                               Margin="0,0,0,18" LineHeight="20">
                        双盲训练完全随机，选取实盘股票走势。您将模拟交易未知时间、未知股票的 150 根 K线/分时，
                        盈亏会影响您的爆竹数和段位，请认真对待。
                    </TextBlock>

                    <!-- 分仓模式 -->
                    <!-- 分仓模式 -->
                    <DockPanel Margin="0,0,14,14">
                        <TextBlock Text="分仓模式" FontSize="14" VerticalAlignment="Center"/>

                        <!-- 开关：最右侧 -->
                        <ToggleButton x:Name="TglSplitPosition" DockPanel.Dock="Right"
              Checked="TglSplitPosition_Checked"
              Unchecked="TglSplitPosition_Unchecked"
              Style="{StaticResource MaterialDesignSwitchToggleButton}"
              Width="45" Height="25" Background="#FF2E5BFF"/>

                        <!-- 滑块区域：开关左侧，打开时显示 -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="280,0,16,0"
                                    Visibility="{Binding ElementName=TglSplitPosition, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <!-- - -->
                            <Button x:Name="BtnSplitMinus" Style="{StaticResource CircleButtonStyle}"
                                    Click="BtnSplitMinus_Click">
                                <TextBlock Text="−" FontSize="12" Margin="0,-1,0,0" Foreground="#666"/>
                            </Button>

                            <!-- Slider -->
                            <Grid Width="110" Height="20" VerticalAlignment="Center" Margin="8,0">
                                <Slider x:Name="SliderSplitPosition" Minimum="10" Maximum="100" Value="10"
        TickFrequency="10" IsSnapToTickEnabled="True"
        ValueChanged="SliderSplitPosition_ValueChanged"
        VerticalAlignment="Center">
                                    <Slider.Template>
                                        <ControlTemplate TargetType="Slider">
                                            <Grid ClipToBounds="False" VerticalAlignment="Center">
                                                <Border Height="4" CornerRadius="2" Background="#E0E0E0" VerticalAlignment="Center"/>
                                                <Track x:Name="PART_Track" VerticalAlignment="Center" ClipToBounds="False">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="Slider.DecreaseLarge" 
                                                                      Style="{StaticResource SliderRepeatButtonStyle}" 
                                                                      Background="#2E5BFF"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="Slider.IncreaseLarge" 
                                                                      Style="{StaticResource SliderRepeatButtonStyle}" 
                                                                      Background="Transparent"/>
                                                    </Track.IncreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Width="14" Height="14" Cursor="Hand" ClipToBounds="False">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Ellipse Fill="#2E5BFF"/>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Slider.Template>
                                </Slider>
                            </Grid>

                            <!-- + -->
                            <Button x:Name="BtnSplitPlus" Style="{StaticResource CircleButtonStyle}"
                                    Click="BtnSplitPlus_Click">
                                <TextBlock Text="+" FontSize="12" Margin="0,-1,0,0" Foreground="#666"/>
                            </Button>

                            <!-- X% -->
                            <TextBlock FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F0}%">
                                        <Binding ElementName="SliderSplitPosition" Path="Value"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <!-- 市场类型 + 训练时间段 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8F9FB" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="市场类型" FontSize="14" Foreground="#999" Margin="0,0,0,8"/>
                                <UniformGrid Columns="4" Rows="1">
                                    <RadioButton Content="不限"   Style="{StaticResource ChipRadioStyle}" GroupName="MarketGroup" IsChecked="True" Margin="1"/>
                                    <RadioButton Content="主板"   Style="{StaticResource ChipRadioStyle}" GroupName="MarketGroup" Margin="1"/>
                                    <RadioButton Content="创业板" Style="{StaticResource ChipRadioStyle}" GroupName="MarketGroup" Margin="1"/>
                                    <RadioButton Content="科创板" Style="{StaticResource ChipRadioStyle}" GroupName="MarketGroup" Margin="1"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F8F9FB" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="训练时间段" FontSize="14" Foreground="#999" Margin="0,0,0,8"/>
                                <UniformGrid Columns="4" Rows="1">
                                    <RadioButton Content="不限"    Style="{StaticResource ChipRadioStyle}" GroupName="PeriodGroup" IsChecked="True" Margin="1"/>
                                    <RadioButton Content="最近5年" Style="{StaticResource ChipRadioStyle}" GroupName="PeriodGroup" Margin="1"/>
                                    <RadioButton Content="近10年" Style="{StaticResource ChipRadioStyle}" GroupName="PeriodGroup" Margin="1"/>
                                    <RadioButton Content="10年前"  Style="{StaticResource ChipRadioStyle}" GroupName="PeriodGroup" Margin="1"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 使用爆竹比例 -->
                    <DockPanel Margin="0,0,14,14">
                        <TextBlock Text="使用爆竹比例" FontSize="14" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" 
                                    VerticalAlignment="Center" Width="55">
                            <TextBox x:Name="TxtFirecrackerRatio"
                                     Text="100"
                                     Width="35" FontSize="14"
                                     BorderThickness="0"
                                     Background="#FFFDFDFD"
                                     TextAlignment="Right"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="%" FontSize="14" Foreground="#999" 
                                       Margin="2,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 杠杆：倍数按钮最靠右，开关在倍数左侧 -->
                    <DockPanel Margin="0,0,14,14">
                        <TextBlock Text="杠杆" FontSize="14" VerticalAlignment="Center"/>

						<UniformGrid Columns="4" Width="180" DockPanel.Dock="Right" VerticalAlignment="Center"
             IsEnabled="{Binding ElementName=TglLeverage, Path=IsChecked}">
							<RadioButton x:Name="RdoLeverage1" Content="1倍" GroupName="LeverageGroup" Style="{StaticResource ChipRadioStyle}" IsChecked="True" Margin="2"/>
							<RadioButton x:Name="RdoLeverage2" Content="2倍" GroupName="LeverageGroup" Style="{StaticResource ChipRadioStyle}" Margin="2"/>
							<RadioButton x:Name="RdoLeverage3" Content="3倍" GroupName="LeverageGroup" Style="{StaticResource ChipRadioStyle}" Margin="2"/>
							<RadioButton x:Name="RdoLeverage4" Content="4倍" GroupName="LeverageGroup" Style="{StaticResource ChipRadioStyle}" Margin="2"/>
						</UniformGrid>

                        <ToggleButton x:Name="TglLeverage" DockPanel.Dock="Right" VerticalAlignment="Center"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      Width="45" Height="25" Margin="0,0,-62,0" Background="#FF2E5BFF"/>
                    </DockPanel>

                    <!-- 周月按日跳 + 开盘买入 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="0">
                            <DockPanel>
                                <ToggleButton x:Name="TglWeekMonthDayJump" DockPanel.Dock="Right"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              Width="45" Height="25" Margin="-91,0,0,0" Background="#FF2E5BFF"/>
                                <TextBlock Text="周月按日跳" FontSize="14" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F8F9FB" CornerRadius="10" Padding="14">
                            <DockPanel>
                                <ToggleButton x:Name="TglOpenBuy" DockPanel.Dock="Right"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              Width="45" Height="25" Background="#FF2E5BFF"/>
                                <TextBlock Text="开盘买入" FontSize="14" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 止盈 + 止损（双列卡片，均带数值调节） -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左边：止盈 -->
                        <Border Grid.Column="0" Background="#F8F9FB" CornerRadius="10" >
                            <DockPanel Cursor="">
                                <ToggleButton x:Name="TglStopProfit" DockPanel.Dock="Right"
                                              IsChecked="False"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              Width="45" Height="25" Margin="0,0,23,0" Background="#FF2E5BFF"/>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Visibility="{Binding ElementName=TglStopProfit, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Background="White" Height="26" Width="52">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Width="14">
                                                <Button x:Name="BtnProfitUp" Content="▲" FontSize="5" Height="13" Padding="0"
                                                        BorderThickness="0" Background="#F0F0F0" Foreground="#666" Cursor="Hand"
                                                        Click="BtnProfitUp_Click"/>
                                                <Button x:Name="BtnProfitDown" Content="▼" FontSize="5" Height="13" Padding="0"
                                                        BorderThickness="0" Background="#F0F0F0" Foreground="#666" Cursor="Hand"
                                                        Click="BtnProfitDown_Click"/>
                                            </StackPanel>
                                            <TextBox x:Name="TxtStopProfit" Text="10"
                                                     BorderThickness="0" Background="Transparent"
                                                     TextAlignment="Center" VerticalAlignment="Center"
                                                     FontSize="13" PreviewTextInput="TxtStopProfit_PreviewTextInput"/>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="%" FontSize="12" Foreground="#666" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="止盈" FontSize="14" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- 右边：止损（独立开关 + 数值调节） -->
                        <Border Grid.Column="2" Background="#F8F9FB" CornerRadius="10" Padding="14">
                            <DockPanel>
                                <ToggleButton x:Name="TglStopLoss" DockPanel.Dock="Right"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              Width="45" Height="25" Background="#FF2E5BFF"/>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                            Visibility="{Binding ElementName=TglStopLoss, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Background="White" Height="26" Width="52">
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Width="14">
                                                <Button x:Name="BtnLossUp" Content="▲" FontSize="5" Height="13" Padding="0"
                                                        BorderThickness="0" Background="#F0F0F0" Foreground="#666" Cursor="Hand"
                                                        Click="BtnLossUp_Click"/>
                                                <Button x:Name="BtnLossDown" Content="▼" FontSize="5" Height="13" Padding="0"
                                                        BorderThickness="0" Background="#F0F0F0" Foreground="#666" Cursor="Hand"
                                                        Click="BtnLossDown_Click"/>
                                            </StackPanel>
                                            <TextBox x:Name="TxtStopLoss" Text="10"
                                                     BorderThickness="0" Background="Transparent"
                                                     TextAlignment="Center" VerticalAlignment="Center"
                                                     FontSize="13" PreviewTextInput="TxtStopLoss_PreviewTextInput"/>
                                        </DockPanel>
                                    </Border>
                                    <TextBlock Text="%" FontSize="12" Foreground="#666" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="止损" FontSize="14" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- 自动卖出 -->
                    <!-- 自动卖出 -->
                    <DockPanel Margin="0,0,14,14">
                        <TextBlock Text="自动卖出" FontSize="14" VerticalAlignment="Center"/>

                        <!-- 开关：最右侧 -->
                        <ToggleButton x:Name="TglAutoSell" DockPanel.Dock="Right"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      Width="45" Height="25" Background="#FF2E5BFF"/>

                        <!-- 滑块区域：开关左侧，打开时显示 -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center" Margin="280,0,16,0"
                                    Visibility="{Binding ElementName=TglAutoSell, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <!-- - -->
                            <Button x:Name="BtnAutoSellMinus" Style="{StaticResource CircleButtonStyle}"
                                    Click="BtnAutoSellMinus_Click">
                                <TextBlock Text="−" FontSize="12" Margin="0,-1,0,0" Foreground="#666"/>
                            </Button>

                            <!-- Slider：灰色轨道 + 蓝色圆点 -->
                            <!-- Slider：灰色轨道 + 蓝色圆点 -->
                            <Grid Width="110" Height="26" VerticalAlignment="Center" Margin="8,0">
                                <Slider x:Name="SliderAutoSell" Minimum="1" Maximum="150" Value="10"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center">
                                    <Slider.Template>
                                        <ControlTemplate TargetType="Slider">
                                            <Grid ClipToBounds="False" VerticalAlignment="Center">
                                                <!-- 灰色背景轨道 -->
                                                <Border Height="4" CornerRadius="2" Background="#E0E0E0" VerticalAlignment="Center"/>
                                                <Track x:Name="PART_Track" VerticalAlignment="Center" ClipToBounds="False">
                                                    <Track.DecreaseRepeatButton>
                                                        <RepeatButton Command="Slider.DecreaseLarge" 
                                                                      Style="{StaticResource SliderRepeatButtonStyle}" 
                                                                      Background="#2E5BFF"/>
                                                    </Track.DecreaseRepeatButton>
                                                    <Track.IncreaseRepeatButton>
                                                        <RepeatButton Command="Slider.IncreaseLarge" 
                                                                      Style="{StaticResource SliderRepeatButtonStyle}" 
                                                                      Background="Transparent"/>
                                                    </Track.IncreaseRepeatButton>
                                                    <Track.Thumb>
                                                        <Thumb Width="15" Height="15" Cursor="Hand" ClipToBounds="False">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Ellipse Fill="#2E5BFF" />
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Slider.Template>
                                </Slider>
                            </Grid>

                            <!-- + -->
                            <Button x:Name="BtnAutoSellPlus" Style="{StaticResource CircleButtonStyle}"
                                    Click="BtnAutoSellPlus_Click">
                                <TextBlock Text="+" FontSize="12" Margin="0,-1,0,0" Foreground="#666"/>
                            </Button>

                            <!-- X 天 -->
                            <TextBlock FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:F0}">
                                        <Binding ElementName="SliderAutoSell" Path="Value"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="天" FontSize="14" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 去除ST + 买卖自动跳 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#F8F9FB" CornerRadius="10" >
                            <DockPanel>
                                <ToggleButton x:Name="TglRemoveST" DockPanel.Dock="Right"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              Width="45" Height="25" Background="#FF2E5BFF" Margin="0,0,22,0"/>
                                <TextBlock Text="去除 ST" FontSize="14" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#F8F9FB" CornerRadius="10" Padding="14">
                            <DockPanel>
                                <ToggleButton x:Name="TglTradeAutoSkip" DockPanel.Dock="Right"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              Width="45" Height="25" Background="#FF2E5BFF"/>
                                <TextBlock Text="买卖自动跳" FontSize="14" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Button Grid.Row="2"
                    Content="开始训练"
                    Height="48" Margin="0,8,14,20"
                    FontSize="16" FontWeight="Bold"
                    Foreground="White"
                    Background="#2E5BFF"
                    BorderThickness="0"
                    materialDesign:ButtonAssist.CornerRadius="24"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="StartTraining_Click"/>
        </Grid>
    </Border>
</Window>