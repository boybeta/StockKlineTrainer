<Window x:Class="BaozhuKLineTrainer.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="爆竹K线训练助手" Height="960" Width="1500" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 输入框统一样式：文字垂直居中、字号放大、圆角白底 -->
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,6,0,18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="40 0 10 0"/>
            <!-- 文字垂直居中 + 字号放大 -->
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="PwdBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,6,0,18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="40 0 40 0"/>
            <!-- 文字垂直居中 + 字号放大 -->
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧渐变宣传区域 -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F74477" Offset="0"/>
                    <GradientStop Color="#7744EE" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Firework" Width="120" Height="120" Foreground="White"/>
                <TextBlock Text="爆竹K线训练助手" FontSize="42" Foreground="White" Margin="0,24" FontWeight="SemiBold"/>
                <TextBlock Text="专业K线训练平台，助您提升交易能力，在股市中游刃有余" 
                           Foreground="White" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Width="480"/>
            </StackPanel>
        </Border>

        <!-- 右侧登录表单 -->
        <Border Grid.Column="1" Background="#FFFAFAFA" Padding="140,0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="620">
                <TextBlock Text="欢迎回来" FontSize="36" FontWeight="Bold" Foreground="#222222"/>
                <TextBlock Text="登录您的账户继续训练" Foreground="#888888" Margin="0,0,0,40"/>

                <!-- 手机号 -->
                <TextBlock Text="手机号" Foreground="#444" FontSize="14" Margin="0,0,0,8"/>
                <Grid>
                    <TextBox Style="{StaticResource InputBoxStyle}" Tag="请输入手机号"/>
                    <materialDesign:PackIcon Kind="Phone" Width="20" Height="20" Foreground="#AAAAAA" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                </Grid>

                <!-- 密码 -->
                <TextBlock Text="密码" Foreground="#444" FontSize="14" Margin="0,0,0,8"/>
                <Grid>
                    <PasswordBox Style="{StaticResource PwdBoxStyle}" Tag="请输入密码"/>
                    <materialDesign:PackIcon Kind="Lock" Width="20" Height="20" Foreground="#AAAAAA" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                    <materialDesign:PackIcon Kind="Eye" Width="20" Height="20" Foreground="#AAAAAA" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                </Grid>

                <!-- 图形验证码 -->
                <TextBlock Text="图形验证码" Foreground="#444" FontSize="14" Margin="0,0,0,8"/>
                <Grid Margin="0,6,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Style="{StaticResource InputBoxStyle}" Tag="请输入验证码"/>
                        <materialDesign:PackIcon Kind="Image" Width="20" Height="20" Foreground="#AAAAAA" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0"/>
                    </Grid>
                    <Border Grid.Column="1" Background="#EEEEEE" CornerRadius="6" Margin="10,0,0,0">
                        <TextBlock Text="3 4 9 9" FontSize="22" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- 协议勾选 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,30">
                    <CheckBox IsChecked="True" VerticalAlignment="Center"/>
                    <TextBlock Margin="5,0" VerticalAlignment="Center" FontSize="14">
                        <Run Text="已阅读并同意"/>
                        <Hyperlink NavigateUri="" Foreground="#0066CC">
                            <Run Text="用户协议"/>
                        </Hyperlink>
                        <Run Text=" 和 "/>
                        <Hyperlink NavigateUri="" Foreground="#0066CC">
                            <Run Text="隐私协议"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- 登录按钮 -->
                <Border CornerRadius="8">
                    <Button Background="#F878A0" Foreground="White" Height="52" FontSize="18" BorderThickness="0" Click="LoginBtn_Click">
                        登录
                    </Button>
                </Border>

                <TextBlock Text="忘记密码?" Foreground="#E63957" HorizontalAlignment="Center" Margin="0,24" Cursor="Hand" FontSize="14"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="还没有账户?" Foreground="#666" FontSize="14"/>
                    <TextBlock Margin="5,0" FontSize="14">
                        <Hyperlink Foreground="#E63957">
                            <Run Text="立即注册"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>