<Window x:Class="BaozhuKLineTrainer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="设置"
        Width="420" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei">
	<shell:WindowChrome.WindowChrome>
		<shell:WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="0"/>
	</shell:WindowChrome.WindowChrome>

	<Border Background="{DynamicResource Bg.Card}"
            BorderBrush="{DynamicResource Border.Strong}"
            BorderThickness="1" CornerRadius="12" Margin="8">
		<Grid Margin="24,20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock Text="设置" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource Fg.Primary}"/>

			<StackPanel Grid.Row="1" Margin="0,18,0,0">
				<TextBlock Text="外观主题" Foreground="{DynamicResource Fg.Secondary}" Margin="0,0,0,10"/>
				<RadioButton x:Name="RbDark" Content="深色"
                             Foreground="{DynamicResource Fg.Primary}" GroupName="ThemeGroup" Margin="0,4"/>
				<RadioButton x:Name="RbLight" Content="浅色"
                             Foreground="{DynamicResource Fg.Primary}" GroupName="ThemeGroup" Margin="0,4"/>
			</StackPanel>

			<Button Grid.Row="2" Content="关闭" Width="84" Height="34"
                    HorizontalAlignment="Right"
                    Foreground="{DynamicResource Fg.Secondary}"
                    Background="{DynamicResource Bg.Control}"
                    BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1"
                    Click="BtnClose_Click"/>
		</Grid>
	</Border>
</Window>