<Window x:Class="BaozhuKLineTrainer.RankUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="段位升级"
        Width="380" Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei">

    <!-- 与 TrainingResultWindow 同一套无标题栏圆角卡片骨架 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Bg.CardAlt}"
            CornerRadius="12"
            Margin="8"
            MouseLeftButtonDown="Border_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="#33000000" BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>

        <StackPanel Margin="0,26,0,22">
            <materialDesign:PackIcon Kind="Trophy" Width="40" Height="40"
                                     Foreground="#FFD770" HorizontalAlignment="Center"/>

            <TextBlock Text="恭喜升级到" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Fg.Secondary}"
                       HorizontalAlignment="Center" Margin="0,12,0,4"/>

            <TextBlock x:Name="TxtRankName" Text="黄金账户" FontSize="28" FontWeight="Bold"
                       Foreground="#E84070" HorizontalAlignment="Center"/>

            <!-- 段位徽章：images\{段位名}.png；文件缺失时兜底显示星星图标 -->
            <Grid Width="170" Height="170" Margin="0,18,0,0">
                <materialDesign:PackIcon x:Name="FallbackIcon" Kind="StarCircle"
                                         Width="150" Height="150" Foreground="#FFD770"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                <Image x:Name="RankImage" Width="170" Height="170"
                       Stretch="Uniform" Visibility="Collapsed"/>
            </Grid>

            <TextBlock x:Name="TxtAmount" Text="当前火星币：100,000" FontSize="13"
                       Foreground="{DynamicResource Fg.Muted}"
                       HorizontalAlignment="Center" Margin="0,16,0,0"/>

            <Button Content="继续" Width="140" Height="38" Margin="0,20,0,0"
                    FontSize="13" FontWeight="Bold" Foreground="White"
                    Background="#E84070" BorderThickness="0" IsDefault="True"
                    Click="Continue_Click" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="19">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</Window>